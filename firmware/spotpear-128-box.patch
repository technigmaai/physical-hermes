 #endif
@@ -536,6 +538,70 @@ BoardConfig make() {
   b.cancel_label = "Screen";
   return b;
 }
+#elif CONFIG_HG_BOARD_SPOTPEAR_128_BOX
+// SpotPear ESP32-S3-LCD-1.28-BOX — the round "DeepSeek XiaoZhi AI" robot ball.
+// 1.28" 240x240 GC9A01 over SPI, CST816 touch, one ES8311 doing speaker DAC and
+// microphone ADC on a duplex I2S bus (two analog MEMS microphones wired
+// differentially into its ADC), NS4150B amplifier, battery on a 1:2 divider.
+// The power latch is hardware, so there is no enable pin to drive.
+// Pins: SpotPear's schematic ESP32S3-1.28inch-BOX.pdf and the upstream
+// xiaozhi-esp32 board spotpear/sp-esp32-s3-1.28-box (config.h).
+// docs/hardware.md#spotpear-esp32s3-lcd-128-box
+BoardConfig make() {
+  BoardConfig b{};
+  b.name = kBoardName;
+  b.lcd.enabled = true;
+  b.lcd.controller = LcdController::Gc9a01;
+  b.lcd.width = 240;
+  b.lcd.height = 240;
+  b.lcd.round = true;
+  b.lcd.swap_xy = false;
+  b.lcd.mirror_x = true;   // upstream: esp_lcd_panel_mirror(panel, true, false)
+  b.lcd.mirror_y = false;
+  b.lcd.invert = true;     // upstream: esp_lcd_panel_invert_color(panel, true)
+  b.lcd.gap_x = 0;
+  b.lcd.gap_y = 0;
+  b.lcd.mosi = 2;
+  b.lcd.sclk = 4;
+  b.lcd.cs = 5;
+  b.lcd.dc = 47;
+  b.lcd.rst = 38;
+  b.lcd.backlight = 42;
+  b.lcd.backlight_invert = true;  // DISPLAY_BACKLIGHT_OUTPUT_INVERT, active-low
+  b.lcd.spi_mhz = 40;
+  b.i2c = {15, 14, 400000};
+  b.codec.enabled = true;
+  b.codec.mclk = 16;
+  b.codec.bclk = 9;
+  b.codec.ws = 45;
+  b.codec.dout = 8;
+  b.codec.din = 10;
+  b.codec.pa = 46;
+  // The microphones are analog and land on the ES8311's own ADC, so one codec
+  // handle covers both directions instead of a separate ES7210.
+  b.codec.mic = MicCodec::Es8311;
+  b.touch.enabled = true;
+  b.touch.controller = TouchController::Cst816;
+  b.touch.addr = 0x15;
+  b.touch.rst = 6;
+  b.touch.int_gpio = 12;
+  // The panel sits on its own I2C bus; the codec's (15/14) has nothing on it.
+  b.touch.bus_sda = 11;
+  b.touch.bus_scl = 7;
+  b.touch.width = 240;
+  b.touch.height = 240;
+  b.touch.mirror_x = true;  // keeps touch aligned with the mirrored panel
+  // R31/R32 divide VBAT by two. The charge signal is active-high here, the
+  // opposite of every other board, and there is no latch pin: power_off() is
+  // unavailable (the PWR key owns power-off).
+  b.latch_power = {true, 1, -1, 41, 42, 2, 4200, false};
+  b.latch_power.charging_active_high = true;
+  b.status_led = 48;
+  b.buttons = {0, -1, -1, -1};  // BOOT is TALK
+  b.talk_label = "BOOT";
+  b.cancel_label = "Swipe down";
+  return b;
+}
