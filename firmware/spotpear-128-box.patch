index 0000000..b683919
--- /dev/null
+++ b/firmware/esp32/boards/spotpear-esp32s3-lcd-128-box/sdkconfig.defaults
@@ -0,0 +1,22 @@
+# SpotPear ESP32-S3-LCD-1.28-BOX (the round "DeepSeek XiaoZhi AI" robot ball):
+# ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash, 1.28" 240x240 GC9A01 over SPI,
+# CST816 touch, one ES8311 doing speaker DAC and analog-microphone ADC on a
+# duplex I2S bus, NS4150B amplifier, battery behind a 1:2 divider.
+# Upstream board name: spotpear/sp-esp32-s3-1.28-box.
+# Pins: docs/hardware.md#spotpear-esp32s3-lcd-128-box
+CONFIG_IDF_TARGET="esp32s3"
+# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
+CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
+CONFIG_SPIRAM=y
+CONFIG_SPIRAM_MODE_OCT=y
+CONFIG_SPIRAM_SPEED_80M=y
+# The 115 KB framebuffer and audio buffers go to PSRAM.
+CONFIG_SPIRAM_USE_MALLOC=y
+# If PSRAM ever fails to start, boot anyway so the log and `diag` can say so.
+CONFIG_SPIRAM_IGNORE_NOTFOUND=y
+CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
+# The USB-C socket is the S3's own USB Serial/JTAG, so the console must live
+# there: a secondary console is output-only and typed commands would be lost.
+# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
+CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
+CONFIG_HG_BOARD_SPOTPEAR_128_BOX=y
