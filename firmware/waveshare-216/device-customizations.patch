+"""Saved-history scoping and switching against Hermes's real SQLite schema."""
+import json
+from pathlib import Path
+
+import pytest
+
+from conftest import requires_hermes
+from hermes_gadget_plugin.session_browser import BrowserRequests, snapshot
+
+pytestmark = requires_hermes
+DEVICE = "hg-0123456789abcdef"
+KEY = "agent:main:gadget:dm:" + DEVICE
+
+
+@pytest.fixture
+def saved(tmp_path):
+    from hermes_state import SessionDB
+    home = tmp_path / "hermes-home"
+    home.mkdir()
+    db = SessionDB(home / "state.db")
+    for sid, title in [("saved-one", "Home automation"), ("saved-two", "Weekend plans")]:
+        db.create_session(sid, "gadget", session_key=KEY, user_id=DEVICE, chat_id=DEVICE, chat_type="dm")
+        db.set_session_title(sid, title)
+        db.append_message(sid, "user", "Private transcript text")
+    origin = {"platform": "gadget", "user_id": DEVICE, "chat_id": DEVICE, "chat_type": "dm"}
+    entry = {"session_id": "saved-two", "origin": origin}
+    db.save_gateway_routing_entry(KEY, json.dumps(entry), scope=str((home / "sessions").resolve()))
+    yield home, db, entry
+    db.close()
+
+
+def test_history_includes_unnamed_and_current_but_never_other_devices(saved):
+    home, db, _ = saved
+    db.create_session("foreign", "gadget", session_key=KEY, user_id="other", chat_id="other")
+    db.set_session_title("foreign", "Foreign private title")
+    db.create_session("legacy", "gadget", session_key=KEY)
+    db.set_session_title("legacy", "Unproven owner")
+    db.create_session("unnamed", "gadget", session_key=KEY, user_id=DEVICE, chat_id=DEVICE)
+    result = snapshot(home, DEVICE)
+    assert {s["id"] for s in result["sessions"]} == {"saved-one", "saved-two", "unnamed"}
+    assert next(s for s in result["sessions"] if s["id"] == "saved-two")["current"]
+    assert not next(s for s in result["sessions"] if s["id"] == "saved-one")["current"]
+    assert "Private transcript text" not in json.dumps(result)
+    assert snapshot(home, "other-device") == {"sessions": []}
+
+
+def test_history_rechecks_current_after_switch_and_uses_profile_scope(saved):
+    home, db, entry = saved
+    entry["session_id"] = "saved-one"
+    db.save_gateway_routing_entry(KEY, json.dumps(entry), scope=str((home / "sessions").resolve()))
+    assert next(s for s in snapshot(home, DEVICE)["sessions"] if s["current"])["id"] == "saved-one"
+    db.replace_gateway_routing_entries({}, scope=str((home / "sessions").resolve()))
+    db.save_gateway_routing_entry(KEY, json.dumps(entry), scope="/another-profile/sessions")
+    assert snapshot(home, DEVICE) == {"sessions": []}
+
+
+def test_resume_requires_an_exact_recently_listed_id(monkeypatch):
+    from hermes_gadget_plugin import session_browser as module
+    requests = BrowserRequests()
+    requests.remember(DEVICE, [{"id": "saved-one"}])
+    assert requests.permits(DEVICE, "saved-one")
+    assert not requests.permits("other", "saved-one")
+    assert not requests.permits(DEVICE, "saved-two")
+    assert not requests.permits(DEVICE, "saved-one --all")
+    assert not requests.permits(DEVICE, "saved-one\n/new")
+    at = module.time.monotonic()
+    monkeypatch.setattr(module.time, "monotonic", lambda: at + 601)
+    assert not requests.permits(DEVICE, "saved-one")
+
+
+def test_real_hermes_resume_restores_transcript_and_checks_owner(tmp_path, loop_thread):
+    """Exercise the installed Hermes /resume implementation with a real SessionStore."""
+    import types
+    from gateway.config import GatewayConfig, Platform
+    from gateway.session import SessionSource, SessionStore, AsyncSessionStore
+    from gateway.platforms.event import MessageEvent, MessageType
+    from gateway.slash_commands_session import GatewaySessionCommandsMixin
+    from hermes_state import SessionDB, AsyncSessionDB
+
+    home = tmp_path / "resume-home"
+    home.mkdir()
+    db = SessionDB(home / "state.db")
+    config = GatewayConfig(sessions_dir=home / "sessions")
+    store = SessionStore(config.sessions_dir, config)
+    store._db = db
+    from gateway.platform_registry import PlatformEntry, platform_registry
+    platform_registry.register(PlatformEntry(name="gadget", label="Hermes Gadget",
+        adapter_factory=lambda config: None, check_fn=lambda: True, source="builtin"))
+    source = SessionSource(platform=Platform("gadget"), chat_id=DEVICE, user_id=DEVICE, chat_type="dm")
+    old = store.get_or_create_session(source)
+    db.set_session_title(old.session_id, "Previous conversation")
+    store.append_to_transcript(old.session_id, {"role": "user", "content": "Remember my blue bike"})
+    fresh = store.reset_session(old.session_key)
+    assert fresh.session_id != old.session_id
+
+    class Runner(GatewaySessionCommandsMixin):
+        _normalize_source_for_session_key = staticmethod(lambda source: source)
+        _resume_caller_is_admin = staticmethod(lambda source: False)
+        _release_running_agent_state = staticmethod(lambda key: None)
+        _clear_conversation_scope = staticmethod(lambda *a, **kw: None)
+        _evict_cached_agent = staticmethod(lambda key: None)
+        _gateway_session_origin_for_id = staticmethod(lambda sid: (store.lookup_by_session_id(sid).origin
+            if store.lookup_by_session_id(sid) else None))
+        _session_key_for_source = staticmethod(store._generate_session_key)
+
+    runner = Runner()
+    runner.config = config
+    runner._session_db = AsyncSessionDB(db)
+    runner.async_session_store = AsyncSessionStore(store)
+    event = MessageEvent(text="/resume " + old.session_id, source=source, message_type=MessageType.TEXT)
+    try:
+        result = loop_thread.run(runner._handle_resume_command(event))
+        assert store.peek_session_id(old.session_key) == old.session_id
+        assert "Previous conversation" in result
+        assert any(m.get("content") == "Remember my blue bike" for m in store.load_transcript(old.session_id))
+        db.create_session("foreign-session", "gadget", chat_id="other", user_id="other")
+        event.text = "/resume foreign-session"
+        loop_thread.run(runner._handle_resume_command(event))
+        assert store.peek_session_id(old.session_key) == old.session_id
+    finally:
+        db.close()
