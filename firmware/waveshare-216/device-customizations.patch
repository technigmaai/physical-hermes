index 0000000..0aff18e
--- /dev/null
+++ b/plugin/session_browser.py
@@ -0,0 +1,85 @@
+"""Read-only, device-scoped history; resuming still goes through Hermes /resume.
+
+The profile home is captured when the adapter connects. Never open an unscoped
+process-global DB after a different profile has handled a message.
+"""
+from __future__ import annotations
+
+import json
+import re
+import time
+from datetime import datetime, timezone
+from pathlib import Path
+
+from . import textfmt
+
+SESSION_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}\Z")
+
+
+def _owned(row: dict, device_id: str, *, route: bool = False) -> bool:
+    return (row.get("platform" if route else "source") == "gadget"
+            and row.get("user_id") == device_id and row.get("chat_id") == device_id
+            and not row.get("thread_id"))
+
+
+def _when(value) -> str:
+    try:
+        stamp = float(value)
+        return datetime.fromtimestamp(stamp, timezone.utc).astimezone().strftime("%d %b %H:%M")
+    except (ValueError, TypeError, OSError, OverflowError):
+        return "Saved conversation"
+
+
+def snapshot(home: Path, device_id: str, charset: str = "ascii") -> dict:
+    """Return at most 20 sessions belonging to this device's current routing key.
+
+    No full transcripts, API keys, or other devices' titles cross the wire.
+    Current-route identity and row ownership are both required (legacy rows fail
+    closed). SessionDB projects compression continuations to the live tip.
+    """
+    from hermes_state import SessionDB
+
+    db = SessionDB(home / "state.db", read_only=True)
+    try:
+        entries = db.load_gateway_routing_entries(scope=str((home / "sessions").resolve()))
+        route = None
+        for key, value in entries.items():
+            entry = json.loads(value)
+            if _owned(entry.get("origin") or {}, device_id, route=True):
+                if route is not None:
+                    raise RuntimeError("Multiple device routes; use Hermes on the Mac")
+                route = dict(entry, session_key=key)
+        if route is None:
+            return {"sessions": []}
+        current = db.resolve_resume_session_id(route["session_id"])
+        rows = db.list_sessions_rich(source="gadget", session_key=route["session_key"],
+                                     limit=40, order_by_last_active=True)
+        result = []
+        seen = set()
+        for row in rows:
+            sid = str(row.get("id") or "")
+            if not SESSION_ID.fullmatch(sid) or not _owned(row, device_id) or sid in seen:
+                continue
+            seen.add(sid)
+            title = row.get("title") or row.get("preview") or "Untitled conversation"
+            result.append({"id": sid, "title": textfmt.for_device(str(title), charset)[:160],
+                           "detail": _when(row.get("last_active") or row.get("started_at")),
+                           "current": sid == current})
+            if len(result) == 20:
+                break
+        return {"sessions": result}
+    finally:
+        db.close()
+
+
+class BrowserRequests:
+    """Only a recently listed, exact session ID can become a /resume argument."""
+    def __init__(self):
+        self.allowed: dict[str, tuple[float, set[str]]] = {}
+
+    def remember(self, device_id: str, rows: list[dict]) -> None:
+        self.allowed[device_id] = (time.monotonic(), {r["id"] for r in rows})
+
+    def permits(self, device_id: str, session_id: str) -> bool:
+        at, ids = self.allowed.get(device_id, (0, set()))
+        return bool(SESSION_ID.fullmatch(session_id) and session_id in ids and time.monotonic() - at < 600)
