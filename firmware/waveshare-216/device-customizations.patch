+int Ui::session_rows() const {
+  const int h = info_.height - layout_.top_h - layout_.header_h - layout_.bottom_h;
+  return std::max(1, (h - 4 * layout_.scale) / (24 * layout_.scale));
+}
+
+int Ui::session_hit(int x, int y) const {
+  const int s = layout_.scale;
+  const int top = oy_ + layout_.top_h + layout_.header_h + 2 * s;
+  if (x < ox_ + 4 * s || x >= ox_ + info_.width - 4 * s || y < top) return -1;
+  const int row = (y - top) / (24 * s);
+  return row < session_rows() ? row : -1;
+}
+
+void Ui::draw_sessions(Canvas& c, const UiModel& m, int y0, int) {
+  const int s = layout_.scale, pad = 4 * s, row_h = 24 * s;
+  const int w = info_.width - 2 * pad;
+  for (int i = 0; i < session_rows(); ++i) {
+    const int index = m.scroll + i;
+    if (index < 0 || index >= static_cast<int>(m.sessions.size())) break;
+    const auto& row = m.sessions[static_cast<size_t>(index)];
+    const int y = y0 + 2 * s + i * row_h;
+    const bool selected = index == m.selected;
+    c.fill_round_rect(pad, y, w, row_h - 2 * s, 2 * s, selected ? kBar : bg_);
+    if (selected) c.fill_rect(pad, y + 2 * s, s, row_h - 6 * s, kAccent);
+    const int x = pad + 3 * s, cols = cols_for(w - 6 * s, s);
+    c.text(x, y + 3 * s, fit(row.title, cols), s, selected ? kAccent : kText);
+    c.text(x, y + 13 * s, fit(row.detail, cols), s, row.current ? kGreen : kDim);
+  }
+}
