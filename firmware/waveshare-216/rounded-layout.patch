+TEST("display: rounded 480x480 panel keeps header and footer text clear of its corners") {
+  FakeHal display;
+  display.width = display.height = 480;
+  display.corner_inset = 48;
+  display.emissive = true;
+  display.fb.assign(480 * 480, 0);
+  hg::Ui ui(display);
+  hg::UiModel m;
+  m.screen = hg::Screen::Ready;
+  m.link = hg::Link::Online;
+  m.title = "Hermes Gadget with a very long name";
+  m.hint = "Hold the screen to talk / swipe down to cancel";
+  m.hero = true;
+  ui.render(m);
+  CHECK_EQ(ui.area().width, 480);
+  CHECK_EQ(ui.area().height, 480);
+  const uint16_t bar = hg::rgb565(24, 31, 42);
+  int stray = 0, foreground = 0;
+  for (int y = 0; y < 480; ++y) {
+    if (y >= ui.layout().top_h && y < 480 - ui.layout().bottom_h) continue;
+    for (int x = 0; x < 480; ++x) {
+      const bool painted = display.fb[y * 480 + x] != bar;
+      if (x < 48 || x >= 432) stray += painted;
+      else foreground += painted;
+    }
+  }
+  CHECK_EQ(stray, 0);
+  CHECK(foreground > 100);  // labels are visible, not simply hidden
+}
